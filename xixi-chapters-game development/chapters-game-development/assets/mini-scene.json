                      "id": "ex_l014",
                      "kind": "line",
                      "character": "Evan",
                      "script": "Before you leave.",
                      "emotion": "neutral",
                      "thought_bubble": "no"
                    },
                    {
                      "id": "ex_l015",
                      "kind": "line",
                      "character": "Narration",
                      "script": "You close the folder. This time, nobody reaches to take it from you.",
                      "emotion": "neutral",
                      "thought_bubble": "no"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "ex_pc01_b",
          "price": 12,
          "button": "Secure his private backing before the next board vote.",
