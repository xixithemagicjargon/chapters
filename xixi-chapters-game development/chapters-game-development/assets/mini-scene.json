              "thought_bubble": "no"
            }
          ]
        },
        {
          "id": "ex_fc01_b",
          "price": 0,
          "button": "Let the document do the talking.",
          "nodes": [
            {
              "id": "ex_l004",
              "kind": "line",
              "character": "Narration",
              "script": "You slide the original across the table, signature facing up.",
